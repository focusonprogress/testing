<roblox xmlns:xmime="http://www.w3.org/2005/05/xmlmime" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="http://www.roblox.com/roblox.xsd" version="4"><Item class="Folder" referent="RBX00000011"><Properties><string name="Name">Rounds</string></Properties><Item class="ModuleScript" referent="RBX0000000D"><Properties><string name="Name">Events</string><ProtectedString name="Source"><![CDATA[--[[
	Events — cada evento é uma função Start(ctx) que devolve:
		{ Stop = function() ... end, OnCharacter = function(player, character) ... end }

	ctx (montado pelo RoundService):
		ctx.Map            -> MapService
		ctx.Runtime        -> pasta no Workspace para colocar peças do evento
		ctx.Speed()        -> multiplicador de velocidade (2 na morte súbita)
		ctx.Alive()        -> lista { Player, Character, Humanoid, Root } de quem está vivo
		ctx.Reward(player, xp, coins, motivo)
		ctx.Info(texto)    -> aviso pequeno na tela de todo mundo
		ctx.SetSwordsOnly(bool)
]]

local Lighting = game:GetService("Lighting")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")
local TweenService = game:GetService("TweenService")
local Debris = game:GetService("Debris")

local function findChild(parent: Instance, name: string): Instance
	local target = name:lower()
	while true do
		for _, child in ipairs(parent:GetChildren()) do
			local clean = child.Name:gsub("^%s+", ""):gsub("%s+$", "")
			if clean:lower() == target then
				return child
			end
		end
		task.wait(0.1)
	end
end

local Shared = findChild(ReplicatedStorage, "Shared")
local RoundConfig = require(findChild(Shared, "RoundConfig"))
local RGB = require(findChild(Shared, "RGB"))

local Tuning = RoundConfig.Tuning

local Events = {}

---------------------------------------------------------------------
-- Ajudantes
---------------------------------------------------------------------
local function newPart(props): any
	local part: any = Instance.new("Part")
	part.Anchored = true
	part.CanCollide = false
	part.CanQuery = false
	part.CanTouch = false
	part.CastShadow = false
	part.TopSurface = Enum.SurfaceType.Smooth
	part.BottomSurface = Enum.SurfaceType.Smooth
	for key, value in pairs(props) do
		part[key] = value
	end
	return part
end

local function horizontalDistance(a: Vector3, b: Vector3): number
	return Vector3.new(a.X - b.X, 0, a.Z - b.Z).Magnitude
end

local function maxSize(part: BasePart): number
	return math.max(part.Size.X, part.Size.Y, part.Size.Z)
end

local function detach(part: BasePart)
	for _, joint in ipairs(part:GetJoints()) do
		joint:Destroy()
	end
	part.Anchored = false
end

-- Faz um loop até `running()` virar false, passando o dt
local function loop(running: () -> boolean, interval: number, fn: (number) -> ())
	task.spawn(function()
		local last = os.clock()
		while running() do
			task.wait(interval)
			local now = os.clock()
			if not running() then
				break
			end
			local ok, err = pcall(fn, now - last)
			if not ok then
				warn("[Rounds] Erro num evento:", err)
			end
			last = now
		end
	end)
end

local function explode(position: Vector3, radius: number, runtime: Instance)
	local explosion = Instance.new("Explosion")
	explosion.Position = position
	explosion.BlastRadius = radius
	explosion.BlastPressure = 400000
	explosion.DestroyJointRadiusPercent = 1
	explosion.Parent = runtime
end

---------------------------------------------------------------------
-- EVENTOS QUE ENCOLHEM O MAPA
---------------------------------------------------------------------
function Events.Lava(ctx)
	local info = ctx.Map.Info
	local width = math.min(2048, info.Radius * 2 + 400)
	local lava = newPart({
		Name = "Lava",
		Size = Vector3.new(width, 4, width),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 90, 20),
		Transparency = 0.15,
		Parent = ctx.Runtime,
	})
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 120, 40)
	light.Range = 60
	light.Brightness = 3
	light.Parent = lava

	local level = info.MinY - 1
	local rise = (info.MaxY - info.MinY) / Tuning.LavaRiseTime
	local running = true
	local meltTimer = 0

	loop(function()
		return running
	end, 0.2, function(dt)
		level = math.min(level + rise * dt * ctx.Speed(), info.MaxY + 5)
		lava.CFrame = CFrame.new(info.Center.X, level - 2, info.Center.Z)

		for _, alive in ipairs(ctx.Alive()) do
			if alive.Root.Position.Y - 2.5 < level then
				alive.Humanoid:TakeDamage(Tuning.LavaDamagePerSecond * dt)
			end
		end

		-- tijolos que a lava cobre derretem
		meltTimer += dt
		if meltTimer >= 1 then
			meltTimer = 0
			for _, part in ipairs(ctx.Map.GetParts()) do
				if part.Parent and part.Position.Y + part.Size.Y / 2 < level - 1 and maxSize(part) < Tuning.MeltIgnoreBiggerThan then
					part:Destroy()
				end
			end
		end
	end)

	return {
		Stop = function()
			running = false
			lava:Destroy()
		end,
	}
end

function Events.Melt(ctx)
	local info = ctx.Map.Info
	local level = info.MinY
	local rise = (info.MaxY - info.MinY) / Tuning.MeltTime
	local running = true

	-- Derrete só os tijolos soltos (as torres). Se o mapa for todo ancorado, derrete tudo.
	local onlyUnanchored = false
	for _, part in ipairs(ctx.Map.GetParts()) do
		if not part.Anchored then
			onlyUnanchored = true
			break
		end
	end

	loop(function()
		return running
	end, 0.5, function(dt)
		level += rise * dt * ctx.Speed()
		for _, part in ipairs(ctx.Map.GetParts()) do
			if
				part.Parent
				and not part:GetAttribute("Melting")
				and not part:IsA("SpawnLocation")
				and part.Position.Y - part.Size.Y / 2 < level
				and maxSize(part) < Tuning.MeltIgnoreBiggerThan
				and (not onlyUnanchored or not part.Anchored)
			then
				part:SetAttribute("Melting", true)
				part.Material = Enum.Material.Neon
				part.Color = Color3.fromRGB(255, 120, 30)
				Debris:AddItem(part, 0.7)
			end
		end
	end)

	return {
		Stop = function()
			running = false
		end,
	}
end

function Events.Edge(ctx)
	local info = ctx.Map.Info
	local radius = info.Radius
	local shrink = (info.Radius - Tuning.EdgeMinRadius) / Tuning.EdgeShrinkTime
	local running = true

	loop(function()
		return running
	end, 0.5, function(dt)
		radius = math.max(Tuning.EdgeMinRadius, radius - shrink * dt * ctx.Speed())
		for _, part in ipairs(ctx.Map.GetParts()) do
			if
				part.Parent
				and not part:GetAttribute("Falling")
				and maxSize(part) < Tuning.MeltIgnoreBiggerThan
				and horizontalDistance(part.Position, info.Center) > radius
			then
				part:SetAttribute("Falling", true)
				part.Color = part.Color:Lerp(Color3.new(0, 0, 0), 0.5)
				detach(part)
				Debris:AddItem(part, 8)
			end
		end
	end)

	return {
		Stop = function()
			running = false
		end,
	}
end

function Events.Zone(ctx)
	local info = ctx.Map.Info
	local radius = info.Radius + 10
	local shrink = (radius - Tuning.ZoneMinRadius) / Tuning.ZoneShrinkTime
	local height = (info.MaxY - info.MinY) + 200
	local running = true

	local zone = newPart({
		Name = "SafeZone",
		Shape = Enum.PartType.Cylinder,
		Material = Enum.Material.ForceField,
		Color = Color3.fromRGB(80, 255, 120),
		Parent = ctx.Runtime,
	})

	local function updateZone()
		local diameter = math.min(2048, radius * 2)
		zone.Size = Vector3.new(height, diameter, diameter)
		zone.CFrame = CFrame.new(info.Center.X, (info.MinY + info.MaxY) / 2, info.Center.Z) * CFrame.Angles(0, 0, math.rad(90))
	end
	updateZone()

	loop(function()
		return running
	end, 0.2, function(dt)
		radius = math.max(Tuning.ZoneMinRadius, radius - shrink * dt * ctx.Speed())
		updateZone()
		for _, alive in ipairs(ctx.Alive()) do
			if horizontalDistance(alive.Root.Position, info.Center) > radius then
				alive.Humanoid:TakeDamage(Tuning.ZoneDamagePerSecond * dt * ctx.Speed())
			end
		end
	end)

	return {
		Stop = function()
			running = false
			zone:Destroy()
		end,
	}
end

---------------------------------------------------------------------
-- EVENTOS ALEATÓRIOS
---------------------------------------------------------------------
local function fallingProjectiles(ctx, every: number, make: (Vector3) -> ())
	local running = true
	loop(function()
		return running
	end, every, function()
		make(ctx.Map.RandomPoint(ctx.Map.Info.MaxY + 70))
	end)
	return {
		Stop = function()
			running = false
		end,
	}
end

function Events.Meteors(ctx)
	return fallingProjectiles(ctx, Tuning.MeteorEvery, function(position)
		local meteor = newPart({
			Name = "Meteor",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(4, 4, 4),
			Material = Enum.Material.Neon,
			Color = Color3.fromRGB(255, 120, 30),
			Anchored = false,
			CanCollide = true,
			CanTouch = true,
			Position = position,
			Parent = ctx.Runtime,
		})
		Instance.new("Fire", meteor).Size = 8
		meteor.AssemblyLinearVelocity = Vector3.new(math.random(-20, 20), -140, math.random(-20, 20))
		meteor:SetNetworkOwner(nil)

		local exploded = false
		meteor.Touched:Connect(function(hit)
			if exploded or hit.Name == "Meteor" or hit:IsDescendantOf(ctx.Runtime) then
				return
			end
			exploded = true
			explode(meteor.Position, 7, ctx.Runtime)
			meteor:Destroy()
		end)
		Debris:AddItem(meteor, 12)
	end)
end

function Events.Bombs(ctx)
	return fallingProjectiles(ctx, Tuning.BombEvery, function(position)
		local bomb = newPart({
			Name = "Bomb",
			Shape = Enum.PartType.Ball,
			Size = Vector3.new(3, 3, 3),
			Color = Color3.fromRGB(25, 25, 25),
			Anchored = false,
			CanCollide = true,
			Position = position,
			Parent = ctx.Runtime,
		})
		local light = Instance.new("PointLight")
		light.Color = Color3.fromRGB(255, 40, 40)
		light.Range = 12
		light.Parent = bomb
		bomb:SetNetworkOwner(nil)

		task.spawn(function()
			-- pisca cada vez mais rápido e explode
			for i = 1, 12 do
				if not bomb.Parent then
					return
				end
				light.Enabled = not light.Enabled
				bomb.Color = light.Enabled and Color3.fromRGB(200, 30, 30) or Color3.fromRGB(25, 25, 25)
				task.wait(0.4 - i * 0.025)
			end
			if bomb.Parent then
				explode(bomb.Position, 11, ctx.Runtime)
				bomb:Destroy()
			end
		end)
	end)
end

function Events.LowGravity(ctx)
	local original = workspace.Gravity
	workspace.Gravity = Tuning.LowGravity
	return {
		Stop = function()
			workspace.Gravity = original
		end,
	}
end

function Events.Speed(ctx)
	local function apply(humanoid: Humanoid)
		humanoid.WalkSpeed = Tuning.SpeedWalkSpeed
	end
	for _, alive in ipairs(ctx.Alive()) do
		apply(alive.Humanoid)
	end
	return {
		OnCharacter = function(_, character)
			local humanoid = character:FindFirstChildOfClass("Humanoid")
			if humanoid then
				apply(humanoid)
			end
		end,
		Stop = function()
			for _, player in ipairs(Players:GetPlayers()) do
				local humanoid = player.Character and player.Character:FindFirstChildOfClass("Humanoid")
				if humanoid then
					humanoid.WalkSpeed = StarterPlayer.CharacterWalkSpeed
				end
			end
		end,
	}
end

function Events.Blackout(ctx)
	local saved = {
		ClockTime = Lighting.ClockTime,
		Brightness = Lighting.Brightness,
		Ambient = Lighting.Ambient,
		OutdoorAmbient = Lighting.OutdoorAmbient,
	}
	local info = TweenInfo.new(2)
	TweenService:Create(Lighting, info, {
		ClockTime = 0,
		Brightness = 0,
		Ambient = Color3.fromRGB(15, 15, 30),
		OutdoorAmbient = Color3.fromRGB(20, 20, 40),
	}):Play()
	return {
		Stop = function()
			TweenService:Create(Lighting, info, saved):Play()
		end,
	}
end

function Events.SwordDuel(ctx)
	ctx.SetSwordsOnly(true)
	return {
		Stop = function()
			ctx.SetSwordsOnly(false)
		end,
	}
end

function Events.GoldenBrick(ctx)
	local info = ctx.Map.Info
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	local exclude = { ctx.Runtime }
	for _, player in ipairs(Players:GetPlayers()) do
		if player.Character then
			table.insert(exclude, player.Character)
		end
	end
	params.FilterDescendantsInstances = exclude

	-- tenta achar um lugar com chão embaixo
	local position = Vector3.new(info.Center.X, info.MaxY + 3, info.Center.Z)
	for _ = 1, 15 do
		local origin = ctx.Map.RandomPoint(info.MaxY + 50)
		local result = workspace:Raycast(origin, Vector3.new(0, -(info.MaxY - info.MinY) - 100, 0), params)
		if result then
			position = result.Position + Vector3.new(0, 3, 0)
			break
		end
	end

	local brick = newPart({
		Name = "GoldenBrick",
		Size = Vector3.new(3, 3, 3),
		Material = Enum.Material.Neon,
		Color = Color3.fromRGB(255, 210, 60),
		CanTouch = true,
		CFrame = CFrame.new(position),
		Parent = ctx.Runtime,
	})
	RGB.Apply(brick, "Rainbow", 0.6)
	Instance.new("Sparkles", brick)
	local light = Instance.new("PointLight")
	light.Color = Color3.fromRGB(255, 220, 100)
	light.Range = 20
	light.Brightness = 3
	light.Parent = brick

	local running = true
	loop(function()
		return running and brick.Parent ~= nil
	end, 0.05, function(dt)
		brick.CFrame = brick.CFrame * CFrame.Angles(0, dt * 2, 0)
	end)

	brick.Touched:Connect(function(hit)
		if not running then
			return
		end
		local player = Players:GetPlayerFromCharacter(hit.Parent)
		local humanoid = hit.Parent and hit.Parent:FindFirstChildOfClass("Humanoid")
		if player and humanoid and humanoid.Health > 0 then
			running = false
			brick:Destroy()
			ctx.Reward(player, RoundConfig.GoldenBrickReward.XP, RoundConfig.GoldenBrickReward.Coins, "Pegou o tijolo dourado! 💎")
			ctx.Info(("💎 %s pegou o tijolo dourado!"):format(player.DisplayName))
		end
	end)

	return {
		Stop = function()
			running = false
			if brick.Parent then
				brick:Destroy()
			end
		end,
	}
end

function Events.KingHunt(ctx)
	local alive = ctx.Alive()
	if #alive < 2 then
		ctx.Info("👑 Precisa de 2 jogadores vivos pra ter rei!")
		return { Stop = function() end }
	end

	local chosen = alive[math.random(1, #alive)]
	local king: Player = chosen.Player
	local kingAlive = true
	local connections = {}

	local highlight = Instance.new("Highlight")
	highlight.Name = "KingHighlight"
	highlight.FillColor = Color3.fromRGB(255, 210, 60)
	highlight.FillTransparency = 0.6
	highlight.OutlineColor = Color3.new(1, 1, 1)
	highlight.Parent = chosen.Character

	local crown = Instance.new("BillboardGui")
	crown.Name = "KingCrown"
	crown.Size = UDim2.fromOffset(160, 40)
	crown.StudsOffset = Vector3.new(0, 5.5, 0)
	crown.AlwaysOnTop = true
	crown.LightInfluence = 0
	local label = Instance.new("TextLabel")
	label.BackgroundTransparency = 1
	label.Size = UDim2.fromScale(1, 1)
	label.Font = Enum.Font.GothamBlack
	label.TextScaled = true
	label.Text = "👑 REI 👑"
	local stroke = Instance.new("UIStroke")
	stroke.Thickness = 2
	stroke.Parent = label
	label.Parent = crown
	RGB.Apply(label, "Gradient", 0.8)
	crown.Parent = chosen.Root

	ctx.Info(("👑 %s é o rei! Derrube ele!"):format(king.DisplayName))

	table.insert(connections, chosen.Humanoid.Died:Connect(function()
		if not kingAlive then
			return
		end
		kingAlive = false
		local tag = chosen.Humanoid:FindFirstChild("creator")
		local killer = tag and tag:IsA("ObjectValue") and tag.Value
		if killer and killer:IsA("Player") and killer ~= king and killer.Parent then
			ctx.Reward(killer, RoundConfig.KingKillReward.XP, RoundConfig.KingKillReward.Coins, "Derrubou o rei! 👑")
			ctx.Info(("👑 %s derrubou o rei %s!"):format(killer.DisplayName, king.DisplayName))
		else
			ctx.Info(("👑 O rei %s caiu!"):format(king.DisplayName))
		end
	end))

	return {
		Stop = function()
			for _, connection in ipairs(connections) do
				connection:Disconnect()
			end
			highlight:Destroy()
			crown:Destroy()
			if kingAlive and king.Parent and chosen.Humanoid.Health > 0 then
				ctx.Reward(king, RoundConfig.KingSurviveReward.XP, RoundConfig.KingSurviveReward.Coins, "Sobreviveu como rei! 👑")
				ctx.Info(("👑 O rei %s sobreviveu!"):format(king.DisplayName))
			end
		end,
	}
end

return Events
]]></ProtectedString></Properties></Item><Item class="Script" referent="RBX0000000E"><Properties><string name="Name">Main</string><ProtectedString name="Source"><![CDATA[-- Liga o sistema de rodadas (intermissão, votação, eventos, vitória).
-- Desligue (Disabled) outros scripts que fazem rodada/respawn/regen, como GameControl e RegenControl.

local function findChild(parent: Instance, name: string): Instance
	local target = name:lower()
	while true do
		for _, child in ipairs(parent:GetChildren()) do
			local clean = child.Name:gsub("^%s+", ""):gsub("%s+$", "")
			if clean:lower() == target then
				return child
			end
		end
		task.wait(0.1)
	end
end

local RoundService = require(findChild(script.Parent, "RoundService"))
RoundService.Init()
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX0000000F"><Properties><string name="Name">MapService</string><ProtectedString name="Source"><![CDATA[--[[
	MapService — guarda uma cópia do mapa, reconstrói a cada rodada e
	descobre as torres (pelos SpawnLocations de cada time).
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local ServerStorage = game:GetService("ServerStorage")

local function findChild(parent: Instance, name: string): Instance
	local target = name:lower()
	while true do
		for _, child in ipairs(parent:GetChildren()) do
			local clean = child.Name:gsub("^%s+", ""):gsub("%s+$", "")
			if clean:lower() == target then
				return child
			end
		end
		task.wait(0.1)
	end
end

local RoundConfig = require(findChild(findChild(ReplicatedStorage, "Shared"), "RoundConfig"))

local MapService = {}

MapService.RuntimeName = "RoundRuntime" -- pasta dos efeitos dos eventos (lava, meteoros...)

MapService.Info = {
	Center = Vector3.zero,
	MinY = 0,
	MaxY = 50,
	Radius = 100,
}

local backup = Instance.new("Folder")
backup.Name = "MapBackup"
backup.Parent = ServerStorage

local usingContainer = false
local parts: { BasePart } = {}
local spawns: { { Spawn: SpawnLocation, OriginY: number } } = {}

local function isIgnored(obj: Instance): boolean
	if obj:IsA("Terrain") or obj:IsA("Camera") then
		return true
	end
	if table.find(RoundConfig.IgnoreInWorkspace, obj.Name) then
		return true
	end
	if obj.Name == MapService.RuntimeName or obj:GetAttribute("IgnoreRegen") then
		return true
	end
	if obj:IsA("Model") and Players:GetPlayerFromCharacter(obj) then
		return true
	end
	return false
end

local function getContainer(): Instance?
	if RoundConfig.MapName ~= "" then
		return workspace:FindFirstChild(RoundConfig.MapName, true)
	end
	return nil
end

-- No modo "container", reconstrói os filhos dele, menos scripts e valores do jogo
local function keepInContainer(obj: Instance): boolean
	return obj:IsA("BaseScript") or obj:IsA("ModuleScript") or obj.Name == "GameValues"
end

-- Raízes do mapa que estão no Workspace agora
function MapService.GetRoots(): { Instance }
	if usingContainer then
		local container = getContainer()
		local roots = {}
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if not keepInContainer(child) then
					table.insert(roots, child)
				end
			end
		end
		return roots
	end
	local roots = {}
	for _, child in ipairs(workspace:GetChildren()) do
		if not isIgnored(child) then
			table.insert(roots, child)
		end
	end
	return roots
end

function MapService.Scan()
	parts = {}
	spawns = {}

	local minV = Vector3.new(math.huge, math.huge, math.huge)
	local maxV = Vector3.new(-math.huge, -math.huge, -math.huge)

	local function consider(obj: Instance)
		if obj:IsA("BasePart") then
			table.insert(parts, obj)
			local half = obj.Size / 2
			minV = minV:Min(obj.Position - half)
			maxV = maxV:Max(obj.Position + half)
			if obj:IsA("SpawnLocation") then
				table.insert(spawns, { Spawn = obj, OriginY = obj.Position.Y })
			end
		end
	end

	for _, root in ipairs(MapService.GetRoots()) do
		consider(root)
		for _, obj in ipairs(root:GetDescendants()) do
			consider(obj)
		end
	end

	if #parts > 0 then
		local center = (minV + maxV) / 2
		MapService.Info = {
			Center = center,
			MinY = minV.Y,
			MaxY = maxV.Y,
			Radius = math.max(maxV.X - minV.X, maxV.Z - minV.Z) / 2,
		}
	end
end

-- Guarda a cópia do mapa (chamado uma vez quando o servidor liga)
function MapService.Snapshot()
	backup:ClearAllChildren()

	local container = getContainer()
	usingContainer = container ~= nil
	if RoundConfig.MapName ~= "" and not container then
		warn(("[Rounds] Não achei o mapa '%s' no Workspace. Usando o Workspace inteiro."):format(RoundConfig.MapName))
	end

	for _, root in ipairs(MapService.GetRoots()) do
		local wasArchivable = root.Archivable
		root.Archivable = true
		local copy = root:Clone()
		root.Archivable = wasArchivable
		if copy then
			copy.Parent = backup
		end
	end

	MapService.Scan()
	print(("[Rounds] Mapa salvo: %d peças, %d spawns."):format(#parts, #spawns))
end

-- Apaga o mapa atual (com tudo que foi construído/destruído) e coloca a cópia
function MapService.Regenerate()
	for _, root in ipairs(MapService.GetRoots()) do
		pcall(function()
			root:Destroy()
		end)
	end
	local destination = usingContainer and getContainer() or workspace
	if not destination then
		warn("[Rounds] O mapa '" .. RoundConfig.MapName .. "' sumiu do Workspace! Reconstruindo direto no Workspace.")
		destination = workspace
	end
	for _, copy in ipairs(backup:GetChildren()) do
		copy:Clone().Parent = destination
	end

	-- gruda os tijolos de novo (as torres do Doomspire usam juntas de superfície)
	if RoundConfig.MakeJointsAfterRegen then
		for _, root in ipairs(MapService.GetRoots()) do
			if root:IsA("Model") or root:IsA("BasePart") then
				pcall(function()
					local target: any = root
					target:MakeJoints()
				end)
			else
				for _, child in ipairs(root:GetDescendants()) do
					if child:IsA("Model") and child.Parent == root then
						pcall(function()
							local target: any = child
							target:MakeJoints()
						end)
					end
				end
			end
		end
	end

	MapService.Scan()
end

function MapService.GetParts(): { BasePart }
	return parts
end

local function spawnAlive(record): boolean
	local spawn = record.Spawn
	if spawn.Parent == nil or not spawn:IsDescendantOf(workspace) then
		return false
	end
	if spawn.Position.Y < record.OriginY - RoundConfig.SpawnFallTolerance then
		return false
	end
	-- arremessado pra longe (o GameControl antigo também checava isso)
	local center = MapService.Info.Center
	local flat = Vector3.new(spawn.Position.X - center.X, 0, spawn.Position.Z - center.Z)
	return flat.Magnitude < MapService.Info.Radius + RoundConfig.SpawnFlungDistance
end

function MapService.GetAliveSpawns(): { SpawnLocation }
	local result = {}
	for _, record in ipairs(spawns) do
		if spawnAlive(record) then
			table.insert(result, record.Spawn)
		end
	end
	return result
end

-- Spawns da torre do time que ainda estão de pé
function MapService.GetTeamSpawns(team: Team): { SpawnLocation }
	local result = {}
	for _, record in ipairs(spawns) do
		local spawn = record.Spawn
		if not spawn.Neutral and spawn.TeamColor == team.TeamColor and spawnAlive(record) then
			table.insert(result, spawn)
		end
	end
	return result
end

function MapService.GetRuntimeFolder(): Folder
	local folder = workspace:FindFirstChild(MapService.RuntimeName)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = MapService.RuntimeName
		folder.Parent = workspace
	end
	return folder
end

function MapService.ClearRuntime()
	local folder = workspace:FindFirstChild(MapService.RuntimeName)
	if folder then
		folder:ClearAllChildren()
	end
end

-- Ponto aleatório dentro do mapa (horizontal), na altura pedida
function MapService.RandomPoint(y: number): Vector3
	local info = MapService.Info
	local angle = math.random() * math.pi * 2
	local distance = math.sqrt(math.random()) * info.Radius * 0.9
	return Vector3.new(info.Center.X + math.cos(angle) * distance, y, info.Center.Z + math.sin(angle) * distance)
end

return MapService
]]></ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX00000010"><Properties><string name="Name">RoundService</string><ProtectedString name="Source"><![CDATA[--[[
	RoundService — ciclo de rodadas:

		Aguardando jogadores -> Intermissão (votação, mapa reconstruído)
		-> Partida (eventos, encolhimento, morte súbita) -> Fim (vencedor, recompensas)

	Ele controla o respawn (Players.CharacterAutoLoads = false), então
	desligue outros scripts que fazem rodada/respawn/regen do mapa
	(ex.: GameControl e RegenControl do Doomspire).
]]

local HttpService = game:GetService("HttpService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local RunService = game:GetService("RunService")
local ServerScriptService = game:GetService("ServerScriptService")
local ServerStorage = game:GetService("ServerStorage")
local Teams = game:GetService("Teams")

local function findChild(parent: Instance, name: string, timeout: number?): Instance?
	local target = name:lower()
	local started = os.clock()
	while true do
		for _, child in ipairs(parent:GetChildren()) do
			local clean = child.Name:gsub("^%s+", ""):gsub("%s+$", "")
			if clean:lower() == target then
				return child
			end
		end
		if timeout and os.clock() - started > timeout then
			return nil
		end
		task.wait(0.1)
	end
end

local Shared = findChild(ReplicatedStorage, "Shared") :: Instance
local RoundConfig = require(findChild(Shared, "RoundConfig") :: any)
local MapService = require(findChild(script.Parent, "MapService") :: any)
local Events = require(findChild(script.Parent, "Events") :: any)

-- Progressão é opcional: se existir, dá vitórias/recompensas
local Progression = nil
task.spawn(function()
	local folder = findChild(ServerScriptService, "Progression", 10)
	local module = folder and findChild(folder, "ProgressionService", 5)
	if module then
		Progression = require(module :: any)
	else
		warn("[Rounds] ProgressionService não encontrado: rodadas sem recompensas.")
	end
end)

local RoundService = {}

---------------------------------------------------------------------
-- Estado
---------------------------------------------------------------------
local phase = "Waiting"
local mode = RoundConfig.Modes[1]
local teamsMode = true
local suddenDeath = false
local roundStartedAt = 0

local votes: { [Player]: string } = {}
local participants: { [Player]: boolean } = {}
local eliminated: { [Player]: boolean } = {}
local lives: { [Player]: number } = {}
local roundKills: { [Player]: number } = {}

local activeEvents: { [string]: any } = {} -- [id] = { Handle, EndsAt, Random }
local swordsOverride = false

local stateFolder: Folder
local remotes: { [string]: any } = {}

local stashRoot = Instance.new("Folder")
stashRoot.Name = "RoundToolStash"
stashRoot.Parent = ServerStorage

---------------------------------------------------------------------
-- Replicação (atributos em ReplicatedStorage.RoundState)
---------------------------------------------------------------------
local function setState(key: string, value: any)
	stateFolder:SetAttribute(key, value)
end

local function serverNow(): number
	return workspace:GetServerTimeNow()
end

local function announce(kind: string, payload: any)
	remotes.Announce:FireAllClients(kind, payload)
end

local function info(text: string)
	announce("Info", { Text = text })
end

local function publishVotes()
	local counts = {}
	for _, modeId in pairs(votes) do
		counts[modeId] = (counts[modeId] or 0) + 1
	end
	setState("Votes", HttpService:JSONEncode(counts))
end

local function publishEvents()
	local list = {}
	for id, active in pairs(activeEvents) do
		table.insert(list, { Id = id, EndsAt = active.EndsAt })
	end
	setState("Events", HttpService:JSONEncode(list))
end

---------------------------------------------------------------------
-- Jogadores vivos / times
---------------------------------------------------------------------
local function getHumanoid(player: Player): Humanoid?
	local character = player.Character
	return character and character:FindFirstChildOfClass("Humanoid")
end

local function isAlive(player: Player): boolean
	local humanoid = getHumanoid(player)
	return humanoid ~= nil and humanoid.Health > 0
end

local function aliveList()
	local result = {}
	for _, player in ipairs(Players:GetPlayers()) do
		local character = player.Character
		local humanoid = getHumanoid(player)
		local root = character and character:FindFirstChild("HumanoidRootPart")
		if humanoid and root and humanoid.Health > 0 then
			table.insert(result, { Player = player, Character = character, Humanoid = humanoid, Root = root })
		end
	end
	return result
end

-- Times que têm pelo menos uma torre (SpawnLocation do time) no mapa
local function towerTeams(): { Team }
	local result = {}
	for _, team in ipairs(Teams:GetTeams()) do
		if #MapService.GetTeamSpawns(team) > 0 then
			table.insert(result, team)
		end
	end
	return result
end

local function canRespawn(player: Player): boolean
	if not player.Parent then
		return false
	end
	if phase ~= "Playing" then
		return true
	end
	if not participants[player] or eliminated[player] or suddenDeath then
		return false
	end
	if mode.Lives then
		return (lives[player] or 0) > 0
	end
	if teamsMode then
		return player.Team ~= nil and #MapService.GetTeamSpawns(player.Team) > 0
	end
	return true
end

local function inGame(player: Player): boolean
	return participants[player] == true
		and player.Parent ~= nil
		and not eliminated[player]
		and (isAlive(player) or canRespawn(player))
end

-- Quem ainda está na disputa: lista de times (modo times) ou de jogadores (FFA)
local function standing(): { any }
	local result = {}
	if teamsMode then
		local seen = {}
		for player in pairs(participants) do
			if inGame(player) and player.Team and not seen[player.Team] then
				seen[player.Team] = true
				table.insert(result, player.Team)
			end
		end
	else
		for player in pairs(participants) do
			if inGame(player) then
				table.insert(result, player)
			end
		end
	end
	return result
end

local function publishTeams()
	local list = {}
	if teamsMode then
		for _, team in ipairs(Teams:GetTeams()) do
			local total, alive = 0, 0
			for _, player in ipairs(team:GetPlayers()) do
				if participants[player] or phase ~= "Playing" then
					total += 1
					if isAlive(player) then
						alive += 1
					end
				end
			end
			if total > 0 then
				table.insert(list, {
					Name = team.Name,
					Color = team.TeamColor.Color:ToHex(),
					Alive = alive,
					Total = total,
					Tower = #MapService.GetTeamSpawns(team) > 0,
				})
			end
		end
	end
	setState("Teams", HttpService:JSONEncode(list))

	local left = 0
	for player in pairs(participants) do
		if inGame(player) then
			left += 1
		end
	end
	setState("PlayersLeft", left)
end

-- Compatibilidade com a interface do jogo (Remotes.ChangeTeam / RequestSpectator)
local function gameRemote(name: string): RemoteEvent?
	local folder = ReplicatedStorage:FindFirstChild("Remotes")
	local remote = folder and folder:FindFirstChild(name)
	if remote and remote:IsA("RemoteEvent") then
		return remote
	end
	return nil
end

local function notifyTeamChange(player: Player)
	local remote = gameRemote("ChangeTeam")
	if remote then
		remote:FireClient(player, player.TeamColor)
	end
end

local function assignTeams()
	local teams = towerTeams()
	local players = Players:GetPlayers()
	-- embaralha
	for i = #players, 2, -1 do
		local j = math.random(1, i)
		players[i], players[j] = players[j], players[i]
	end

	if not mode.Teams or #teams == 0 then
		if mode.Teams then
			warn("[Rounds] Nenhum SpawnLocation de time no mapa: jogando sem times.")
		end
		teamsMode = false
		for _, player in ipairs(players) do
			player.Neutral = true
			player.Team = nil
		end
		return
	end

	teamsMode = true
	for index, player in ipairs(players) do
		player.Neutral = false
		player.Team = teams[((index - 1) % #teams) + 1]
		notifyTeamChange(player)
	end
end

-- Coloca quem entrou no meio da partida no time com menos gente (que ainda tem torre)
local function assignLateJoiner(player: Player)
	if not teamsMode then
		player.Neutral = true
		return
	end
	local best, bestCount = nil, math.huge
	for _, team in ipairs(towerTeams()) do
		local count = #team:GetPlayers()
		if count < bestCount then
			best, bestCount = team, count
		end
	end
	if best then
		player.Neutral = false
		player.Team = best
		notifyTeamChange(player)
	end
end

---------------------------------------------------------------------
-- Armas (intermissão sem armas, modo/evento só espadas)
---------------------------------------------------------------------
local function toolPolicy(): string
	if phase == "Intermission" then
		return "None"
	end
	if phase == "Playing" and (mode.SwordsOnly or swordsOverride) then
		return "Swords"
	end
	return "All"
end

local function isSword(tool: Tool): boolean
	if tool:GetAttribute("ShopGearId") then
		return true
	end
	local name = tool.Name:lower()
	for _, keyword in ipairs(RoundConfig.SwordKeywords) do
		if name:find(keyword, 1, true) then
			return true
		end
	end
	return false
end

local function allowed(tool: Tool, policy: string): boolean
	return policy == "All" or (policy == "Swords" and isSword(tool))
end

local function getStash(player: Player): Folder
	local key = tostring(player.UserId)
	local folder = stashRoot:FindFirstChild(key)
	if not folder then
		folder = Instance.new("Folder")
		folder.Name = key
		folder.Parent = stashRoot
	end
	return folder :: Folder
end

local function filterTool(player: Player, tool: Instance)
	if tool:IsA("Tool") and tool.Parent ~= nil and not allowed(tool, toolPolicy()) then
		tool.Parent = getStash(player)
	end
end

local function applyToolPolicy(player: Player)
	local policy = toolPolicy()
	local backpack = player:FindFirstChildOfClass("Backpack")
	local containers = { backpack, player.Character }

	local have = {}
	for _, container in ipairs(containers) do
		if container then
			for _, child in ipairs(container:GetChildren()) do
				if child:IsA("Tool") then
					if allowed(child, policy) then
						have[child.Name] = true
					else
						child.Parent = getStash(player)
					end
				end
			end
		end
	end

	-- devolve o que voltou a ser permitido
	if backpack then
		for _, tool in ipairs(getStash(player):GetChildren()) do
			if tool:IsA("Tool") and allowed(tool, policy) and not have[tool.Name] then
				have[tool.Name] = true
				tool.Parent = backpack
			end
		end
	end
end

local function applyToolPolicyAll()
	for _, player in ipairs(Players:GetPlayers()) do
		applyToolPolicy(player)
	end
end

local function watchTools(player: Player)
	local function watch(container: Instance)
		container.ChildAdded:Connect(function(child)
			if child:IsA("Tool") then
				task.defer(filterTool, player, child)
			end
		end)
	end
	player.ChildAdded:Connect(function(child)
		if child:IsA("Backpack") then
			watch(child)
		end
	end)
	local backpack = player:FindFirstChildOfClass("Backpack")
	if backpack then
		watch(backpack)
	end
	player.CharacterAdded:Connect(watch)
	if player.Character then
		watch(player.Character)
	end
end

---------------------------------------------------------------------
-- Spawn / morte
---------------------------------------------------------------------
local function chooseSpawn(player: Player): SpawnLocation?
	local list = {}
	if teamsMode and player.Team then
		list = MapService.GetTeamSpawns(player.Team)
	end
	if #list == 0 then
		list = MapService.GetAliveSpawns()
	end
	if #list == 0 then
		return nil
	end
	return list[math.random(1, #list)]
end

local function eliminate(player: Player)
	if eliminated[player] then
		return
	end
	eliminated[player] = true
	player:SetAttribute("Eliminated", true)
end

local spawnPlayer -- declarado abaixo

local function onDied(player: Player, humanoid: Humanoid)
	if phase == "Playing" and participants[player] then
		local tag = humanoid:FindFirstChild("creator")
		local killer = tag and tag:IsA("ObjectValue") and tag.Value
		if killer and killer:IsA("Player") and killer ~= player then
			roundKills[killer] = (roundKills[killer] or 0) + 1
		else
			killer = nil
		end

		local function colorOf(p: Player?): Color3
			if p and teamsMode and p.Team then
				return p.TeamColor.Color
			end
			return Color3.new(1, 1, 1)
		end
		remotes.Killfeed:FireAllClients({
			Killer = killer and killer.DisplayName or nil,
			KillerColor = colorOf(killer),
			Victim = player.DisplayName,
			VictimColor = colorOf(player),
		})

		if mode.Lives then
			lives[player] = math.max(0, (lives[player] or 1) - 1)
			player:SetAttribute("Lives", lives[player])
		end
	end

	task.delay(RoundConfig.RespawnTime, function()
		if not player.Parent or player.Character and getHumanoid(player) ~= humanoid then
			return -- já renasceu por outro motivo
		end
		if canRespawn(player) then
			spawnPlayer(player)
		elseif phase == "Playing" then
			eliminate(player)
		end
	end)
end

spawnPlayer = function(player: Player)
	if not player.Parent then
		return
	end
	getStash(player):ClearAllChildren()

	local spawn = chooseSpawn(player)
	if spawn then
		player.RespawnLocation = spawn
	end

	local ok, err = pcall(function()
		player:LoadCharacter()
	end)
	if not ok then
		warn("[Rounds] LoadCharacter falhou:", err)
		return
	end

	local character = player.Character
	if not character then
		return
	end
	if spawn then
		character:PivotTo(spawn.CFrame + Vector3.new(0, spawn.Size.Y / 2 + 3, 0))
	end
	if phase == "Intermission" then
		Instance.new("ForceField").Parent = character
	end

	local humanoid = character:FindFirstChildOfClass("Humanoid") or character:WaitForChild("Humanoid", 5)
	if humanoid then
		humanoid.Died:Connect(function()
			onDied(player, humanoid :: Humanoid)
		end)
	end

	for _, active in pairs(activeEvents) do
		if active.Handle.OnCharacter then
			pcall(active.Handle.OnCharacter, player, character)
		end
	end

	task.delay(0.5, applyToolPolicy, player)
end

local function spawnAll()
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(spawnPlayer, player)
	end
	task.wait(1)
end

---------------------------------------------------------------------
-- Eventos
---------------------------------------------------------------------
local function eventContext()
	return {
		Map = MapService,
		Runtime = MapService.GetRuntimeFolder(),
		Speed = function()
			return suddenDeath and RoundConfig.Tuning.SuddenDeathSpeedMultiplier or 1
		end,
		Alive = aliveList,
		Reward = function(player: Player, xp: number, coins: number, reason: string)
			if Progression then
				Progression.Reward(player, xp, coins, reason)
			end
		end,
		Info = info,
		SetSwordsOnly = function(value: boolean)
			swordsOverride = value
			applyToolPolicyAll()
		end,
	}
end

local function startEvent(id: string, duration: number?, isRandom: boolean)
	local starter = Events[id]
	if not starter or activeEvents[id] then
		return
	end
	local ok, handle = pcall(starter, eventContext())
	if not ok then
		warn("[Rounds] Evento", id, "deu erro ao começar:", handle)
		return
	end
	activeEvents[id] = {
		Handle = handle,
		EndsAt = duration and (serverNow() + duration) or 0,
		Random = isRandom,
	}
	announce("Event", { Id = id })
	publishEvents()
end

local function stopEvent(id: string)
	local active = activeEvents[id]
	if not active then
		return
	end
	activeEvents[id] = nil
	if active.Handle and active.Handle.Stop then
		local ok, err = pcall(active.Handle.Stop)
		if not ok then
			warn("[Rounds] Evento", id, "deu erro ao parar:", err)
		end
	end
	publishEvents()
end

local function stopAllEvents()
	for id in pairs(activeEvents) do
		stopEvent(id)
	end
	swordsOverride = false
	MapService.ClearRuntime()
end

local function randomEventActive(): boolean
	for _, active in pairs(activeEvents) do
		if active.Random then
			return true
		end
	end
	return false
end

---------------------------------------------------------------------
-- Fases
---------------------------------------------------------------------
local function setPhase(newPhase: string, duration: number?)
	phase = newPhase
	setState("Phase", newPhase)
	setState("EndsAt", duration and (serverNow() + duration) or 0)
end

local function waitForPlayers()
	local minPlayers = RunService:IsStudio() and 1 or RoundConfig.MinPlayers
	if #Players:GetPlayers() >= minPlayers then
		return
	end
	setPhase("Waiting")
	while #Players:GetPlayers() < minPlayers do
		setState("Message", ("Aguardando jogadores (%d/%d)"):format(#Players:GetPlayers(), minPlayers))
		task.wait(1)
	end
	setState("Message", "")
end

local function tallyVotes()
	local counts = {}
	for _, modeId in pairs(votes) do
		counts[modeId] = (counts[modeId] or 0) + 1
	end
	local best, bestCount = {}, 0
	for _, m in ipairs(RoundConfig.Modes) do
		local count = counts[m.Id] or 0
		if count > bestCount then
			best, bestCount = { m }, count
		elseif count == bestCount and count > 0 then
			table.insert(best, m)
		end
	end
	if #best == 0 then
		return RoundConfig.Modes[1]
	end
	return best[math.random(1, #best)]
end

local function intermission()
	votes = {}
	publishVotes()
	setPhase("Intermission", RoundConfig.IntermissionTime)

	MapService.Regenerate()
	local reset = gameRemote("RequestSpectator")
	if reset then
		reset:FireAllClients("GameReset") -- tira todo mundo do modo espectador do jogo
	end
	mode = RoundConfig.Modes[1]
	assignTeams()
	for _, player in ipairs(Players:GetPlayers()) do
		player:SetAttribute("Eliminated", false)
		player:SetAttribute("Lives", nil)
	end
	spawnAll()

	local endsAt = os.clock() + RoundConfig.IntermissionTime - 1
	while os.clock() < endsAt do
		publishTeams()
		task.wait(0.5)
	end
	mode = tallyVotes()
end

local function finishRound(winner: any)
	stopAllEvents()
	setPhase("Ending", RoundConfig.EndingTime)

	local text, color = "EMPATE!", Color3.new(1, 1, 1)
	local winners = {}
	if typeof(winner) == "Instance" and winner:IsA("Team") then
		text = ("TIME %s VENCEU!"):format(winner.Name:upper())
		color = winner.TeamColor.Color
		for player in pairs(participants) do
			if player.Parent and player.Team == winner then
				table.insert(winners, player)
			end
		end
	elseif typeof(winner) == "Instance" and winner:IsA("Player") then
		text = ("%s VENCEU!"):format(winner.DisplayName:upper())
		winners = { winner }
	end

	-- MVP = mais kills na rodada
	local mvp, mvpKills = nil, 0
	for player, kills in pairs(roundKills) do
		if player.Parent and kills > mvpKills then
			mvp, mvpKills = player, kills
		end
	end

	announce("Winner", {
		Text = text,
		Color = color,
		MVP = mvp and mvp.DisplayName or nil,
		MVPKills = mvpKills,
	})

	if Progression then
		for _, player in ipairs(winners) do
			Progression.AddWin(player)
		end
		if mvp then
			Progression.Reward(mvp, RoundConfig.MVPReward.XP, RoundConfig.MVPReward.Coins, "MVP da rodada! ⭐")
		end
	end

	task.wait(RoundConfig.EndingTime)
end

local function playRound()
	suddenDeath = false
	setState("SuddenDeath", false)
	setState("Mode", mode.Id)
	participants, eliminated, lives, roundKills = {}, {}, {}, {}

	assignTeams()
	for _, player in ipairs(Players:GetPlayers()) do
		participants[player] = true
		player:SetAttribute("Eliminated", false)
		if mode.Lives then
			lives[player] = mode.Lives
			player:SetAttribute("Lives", mode.Lives)
		end
	end

	setPhase("Playing", RoundConfig.MaxRoundTime)
	roundStartedAt = os.clock()
	spawnAll() -- todo mundo renasce na torre, com as armas
	announce("RoundStart", { Mode = mode.Id })

	-- Sozinho (ex.: testando no Studio) a rodada só acaba se você for eliminado ou pelo tempo
	local soloTest = #standing() <= 1

	local shrinkStarted = false
	local nextRandomAt = RoundConfig.FirstRandomEventAt
	local lastRandom = nil

	while true do
		task.wait(0.5)
		local elapsed = os.clock() - roundStartedAt

		-- eventos aleatórios que acabaram
		for id, active in pairs(activeEvents) do
			if active.EndsAt > 0 and serverNow() >= active.EndsAt then
				stopEvent(id)
			end
		end

		-- evento que encolhe o mapa
		if not shrinkStarted and elapsed >= RoundConfig.ShrinkStartsAt then
			shrinkStarted = true
			local list = RoundConfig.ShrinkEvents
			startEvent(list[math.random(1, #list)].Id, nil, false)
		end

		-- evento aleatório
		if elapsed >= nextRandomAt and not randomEventActive() then
			local options = {}
			for _, event in ipairs(RoundConfig.RandomEvents) do
				if event.Id ~= lastRandom and not (event.Id == "SwordDuel" and mode.SwordsOnly) then
					table.insert(options, event.Id)
				end
			end
			lastRandom = options[math.random(1, #options)]
			startEvent(lastRandom, mode.EventDuration, true)
			local interval = mode.EventInterval / (suddenDeath and 1.5 or 1)
			nextRandomAt = elapsed + mode.EventDuration + interval
		end

		-- morte súbita
		if not suddenDeath and elapsed >= RoundConfig.SuddenDeathAt then
			suddenDeath = true
			setState("SuddenDeath", true)
			announce("SuddenDeath", {})
			if not shrinkStarted then
				shrinkStarted = true
				startEvent("Lava", nil, false)
			end
		end

		publishTeams()

		-- quem ainda está vivo na disputa?
		local sides = standing()
		if soloTest then
			if #sides == 0 then
				return finishRound(nil)
			end
		elseif #sides <= 1 then
			return finishRound(sides[1])
		end

		-- acabou o tempo: vence quem tiver mais gente viva
		if elapsed >= RoundConfig.MaxRoundTime then
			local best, bestAlive, tie = nil, -1, false
			for _, side in ipairs(sides) do
				local alive = 0
				if typeof(side) == "Instance" and side:IsA("Team") then
					for _, player in ipairs(side:GetPlayers()) do
						if isAlive(player) then
							alive += 1
						end
					end
				else
					alive = isAlive(side) and 1 or 0
				end
				if alive > bestAlive then
					best, bestAlive, tie = side, alive, false
				elseif alive == bestAlive then
					tie = true
				end
			end
			return finishRound(not tie and best or nil)
		end
	end
end

---------------------------------------------------------------------
-- Entrada / saída de jogadores
---------------------------------------------------------------------
local function onPlayerAdded(player: Player)
	watchTools(player)
	player:SetAttribute("Eliminated", false)

	if phase == "Playing" then
		if suddenDeath or mode.Lives then
			-- entrou no meio de uma rodada que não aceita gente nova: assiste
			eliminate(player)
			return
		end
		assignLateJoiner(player)
		participants[player] = true
	elseif phase == "Intermission" then
		assignLateJoiner(player)
	end
	task.spawn(spawnPlayer, player)
end

local function onPlayerRemoving(player: Player)
	votes[player] = nil
	participants[player] = nil
	eliminated[player] = nil
	lives[player] = nil
	roundKills[player] = nil
	local stash = stashRoot:FindFirstChild(tostring(player.UserId))
	if stash then
		stash:Destroy()
	end
	publishVotes()
end

---------------------------------------------------------------------
-- Init
---------------------------------------------------------------------
function RoundService.Init()
	Players.CharacterAutoLoads = false

	stateFolder = Instance.new("Folder")
	stateFolder.Name = "RoundState"
	stateFolder.Parent = ReplicatedStorage

	local remoteFolder = Instance.new("Folder")
	remoteFolder.Name = "RoundRemotes"
	for _, name in ipairs({ "Announce", "Killfeed", "Vote" }) do
		local remote = Instance.new("RemoteEvent")
		remote.Name = name
		remote.Parent = remoteFolder
		remotes[name] = remote
	end
	remoteFolder.Parent = ReplicatedStorage

	setState("Phase", "Waiting")
	setState("EndsAt", 0)
	setState("Mode", mode.Id)
	setState("SuddenDeath", false)
	setState("Teams", "[]")
	setState("Votes", "{}")
	setState("Events", "[]")
	setState("Message", "")
	setState("PlayersLeft", 0)

	remotes.Vote.OnServerEvent:Connect(function(player, modeId)
		if phase ~= "Intermission" or type(modeId) ~= "string" then
			return
		end
		for _, m in ipairs(RoundConfig.Modes) do
			if m.Id == modeId then
				votes[player] = modeId
				publishVotes()
				return
			end
		end
	end)

	task.wait(1) -- deixa o mapa terminar de carregar
	MapService.Snapshot()

	Players.PlayerAdded:Connect(onPlayerAdded)
	Players.PlayerRemoving:Connect(onPlayerRemoving)
	for _, player in ipairs(Players:GetPlayers()) do
		task.spawn(onPlayerAdded, player)
	end

	print("[Rounds] Sistema de rodadas iniciado!")

	task.spawn(function()
		while true do
			local ok, err = pcall(function()
				waitForPlayers()
				intermission()
				playRound()
			end)
			if not ok then
				warn("[Rounds] Erro na rodada, recomeçando:", err)
				stopAllEvents()
				task.wait(3)
			end
		end
	end)
end

return RoundService
]]></ProtectedString></Properties></Item></Item></roblox>